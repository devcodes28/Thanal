<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.thanal.controller.WriteBlogController">
    <top>
        <HBox styleClass="dashboard-header">
            <children>
                <Label text="Write New Blog Post" styleClass="dashboard-title" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#handleBack" text="← Back to Dashboard" />
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="sub-header" text="Blog Title" />
                <TextField fx:id="blogTitleField" promptText="Enter a catchy title..." />

                <Label styleClass="sub-header" text="Blog Content" />
                <TextArea fx:id="blogContentArea" promptText="Write your blog post here..." VBox.vgrow="ALWAYS" />

                <Button onAction="#handlePublishBlog" text="Publish Post" maxWidth="Infinity" />
            </children>
        </VBox>
    </center>
</BorderPane>